{
  "id": "ai-coding",
  "name": "AI Coding Echo",
  "domain": "AI coding tools",
  "scope": "Measured effects of AI coding tools (completion, chat assistants, coding agents) on software work: productivity studies, benchmarks such as SWE-bench, quality and security of AI-written code, AI code review, adoption surveys with data. Out of scope: general LLM news, model launches without coding results, tool tutorials, opinion pieces.",
  "grouping_mode": "questions",
  "subtopics": ["Developer productivity", "Coding agents", "Code completion & chat assistants", "Benchmarks & evaluations", "Code quality & maintainability", "Security of AI-generated code", "AI code review", "Testing & debugging", "Adoption & usage", "Developer experience & trust", "Learning & skills", "Cost & efficiency", "Other"],
  "metrics": ["Task completion time", "Throughput (PRs & commits)", "Benchmark score", "Task success rate", "Defect & bug rate", "Vulnerability rate", "Code churn & duplication", "Suggestion acceptance rate", "Adoption & usage share", "Developer satisfaction & trust", "Cost per task", "Other"],
  "grading": {
    "tiers": {
      "A": "Controlled trial with developers, or a held-out benchmark with a stated contamination control.",
      "B": "Large telemetry or usage dataset, or a public benchmark run.",
      "C": "Case study: one team or project, before/after with real numbers.",
      "D": "Practitioner anecdote: a small measured experiment; anecdotes with numbers are valid D."
    },
    "study_types": [
      "controlled_test",
      "rct",
      "observational",
      "survey",
      "case_series",
      "anecdote",
      "benchmark"
    ],
    "caps": {
      "peer_review": {
        "preprint": "B"
      }
    },
    "labels": [
      "preprint",
      "benchmark"
    ],
    "red_flags": [
      "benchmark_contamination"
    ]
  },
